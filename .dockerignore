# Keep the build context small and free of secrets / local artefacts.
.git
.gitignore
.venv
.env
.python-version

# Local runtime output
cache/
logs/
spark-warehouse/
dist/
data/

# Python / test caches
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/

# Data & image artefacts that must never land in an image
*.parquet
*.tif
*.png
*.qgz

# Editor / planning cruft
.claude/
scripts/temp.py
